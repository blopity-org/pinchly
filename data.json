        "__mwk_calculator": {
            "name": "Calculator",
            "title": "Calculator",
            "subtitle": "Try the built-in math engine",
            "body": "<mwk_text>Enter two numbers and press submit.</mwk_text><mwk_input1><mwk_input2><mwk_submit label='Add numbers'></mwk_submit>",
            "scripts": {
                "onsubmit": {
                    "execute_on": [
                        "__mwk_submit"
                    ],
                    "code_type": "__mwk_script_v0.1",
                    "lines": [
                        "__mwk_setvar sum __mwk_calc __mwk_input1 + __mwk_input2",
                        "__mwk_setvar __mwk_doc_footer sum"
                    ]
                }
            }
        },
        "__mwk_math_lab": {
            "name": "Math Lab",
            "emoji": "🧮",
            "title": "Math Lab",
            "subtitle": "Use simple formulas and built-in operators",
            "theme": {
                "accent": "#2563eb",
                "surface": "#f8fbff",
                "background": "#eef6ff",
                "text": "#172554",
                "border": "#d7e7ff"
            },
            "body": "<mwk_text>Try formulas like 12 + 8, 2 ^ 8, 15 / 3, abs(-7), sqrt(81), round(4.6), floor(4.9), ceil(4.1).</mwk_text><div class='mwk-grid-2'><div class='mwk-card-panel'><div class='mwk-field'><label for='__mwk_input1'>Value A</label><input class='mwk-input' id='__mwk_input1' name='__mwk_input1' type='number' value='10'></div><div class='mwk-field'><label for='__mwk_input2'>Value B</label><input class='mwk-input' id='__mwk_input2' name='__mwk_input2' type='number' value='5'></div><mwk_submit label='Evaluate'></mwk_submit><div class='mwk-output' id='mwkDocFooter'>Your result appears here.</div></div><div class='mwk-card-panel'><p class='mwk-tip'>The engine supports +, -, *, /, %, ^, abs(), sqrt(), round(), floor(), and ceil().</p></div></div>",
            "scripts": {
                "onsubmit": {
                    "execute_on": [
                        "__mwk_submit"
                    ],
                    "code_type": "__mwk_script_v0.1",
                    "lines": [
                        "__mwk_setvar sum __mwk_calc __mwk_input1 + __mwk_input2",
                        "__mwk_setvar __mwk_doc_footer sum"
                    ]
                }
            }
        },
